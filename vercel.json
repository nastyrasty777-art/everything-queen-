{
  "functions": {
    "api/refresh.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/refresh?what=tea", "schedule": "13 12 * * *" },
    { "path": "/api/refresh?what=events", "schedule": "47 12 * * 1" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
